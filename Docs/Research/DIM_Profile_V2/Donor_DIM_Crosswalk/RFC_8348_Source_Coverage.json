  "source_contact": {
    "full_declaration_inventory": "All three embedded module blocks in the published text were indexed for definitions, imports, data nodes, features and notifications. An index entry alone gives no semantic correspondence.",
    "selected_meanings_read": [
      "Sections 2 and 3.1: scope and component key/class.",
      "Section 7.1 /hardware/component: detection and intended-configuration matching by class, parent and parent-relative position, including fallback when no entry matches.",
      "Section 7.1 /hardware/component/mfg-name: manufacturer context for comparing serial, model, firmware and software revision.",
      "Appendix A: the legacy state-only representation has a different standing."
    ],
    "companion_routing": "Sections 4, 5 and 6 supply in-RFC mappings to ENTITY-MIB, ENTITY-SENSOR-MIB and ENTITY-STATE-MIB. These do not imply independent semantic review of every object in the referenced MIBs."
  },
  "comparison_questions": [
    "When may the client identify an expected component as detected, and when does a slot still describe only planned hardware?",
    "Which identifiers refer to a server-local component, a manufacturer-scoped identity or an individual asset?",
    "Which links express physical containment and sibling position?",
    "How should a client display a scaled reading, age, units and validity alongside the component state?"
  ],
  "pending": "Read source semantics for the indexed declarations in scope, compare all 574 existing rows and reconcile newly proposed rows in both directions under the donor plan."
}
