  "initial_native_findings": [
    {
      "id": "SRF-01",
      "subject": "Equipment identity and composition",
      "terms": [
        "Device",
        "DeviceKind",
        "FeatureKind",
        "FeatureOfInterest",
        "hasDeviceKind",
        "hasFeatureKind",
        "hasIdentifier",
        "hasManufacturer",
        "hasModel",
        "hasRevisionNumber",
        "hasVersion",
        "consistsOf"
      ],
      "finding": "A physical unit can be identified separately from its catalog kind. A generic identifier has no built-in persistence or serial-number guarantee. Composition requires identifying the subject, since the same predicate serves other composite entities."
    },
    {
      "id": "SRF-02",
      "subject": "Designed role, purpose and target",
      "terms": [
        "Sensor",
        "Actuator",
        "Meter",
        "Appliance",
        "Task",
        "accomplishes",
        "isAccomplishedBy",
        "targets",
        "isTargetOf",
        "observes",
        "isObservedBy",
        "controls",
        "isControlledBy"
      ],
      "finding": "A task expresses user purpose. A sensor observes, an actuator controls, and a meter adds computation or display. Capability alone supplies no record of execution."
    },
    {
      "id": "SRF-03",
      "subject": "Commodity flows",
      "terms": [
        "Commodity",
        "consumes",
        "isConsumedBy",
        "produces",
        "isProducedBy",
        "stores",
        "isStoredBy"
      ],
      "finding": "Consumption, production and storage relate equipment to a commodity with distinct directions. A stored commodity may differ from the one consumed."
    },
    {
      "id": "SRF-04",
      "subject": "Quality and its value",
      "terms": [
        "Property",
        "PropertyOfInterest",
        "PropertyValue",
        "UnitOfMeasure",
        "hasProperty",
        "hasPropertyKind",
        "hasPropertyOfInterest",
        "hasPropertyValue",
        "isPropertyOf",
        "isPropertyOfInterestOf",
        "isValueOfProperty",
        "isMeasuredIn",
        "hasValue"
      ],
      "finding": "A quality can be generic or particular to a feature. A value can exist independently of a recorded observation. Its literal and unit are optional."
    },
    {
      "id": "SRF-05",
      "subject": "Condition and its value",
      "terms": [
        "State",
        "StateOfInterest",
        "StateValue",
        "hasState",
        "hasStateKind",
        "hasStateOfInterest",
        "hasStateValue",
        "isStateOf",
        "isStateOfInterestOf",
        "isValueOfState"
      ],
      "finding": "Distinguish a reusable condition, a condition tied to a particular feature, and a value describing that condition."
    },
    {
      "id": "SRF-06",
      "subject": "Capability and command contract",
      "terms": [
        "Function",
        "FunctionOfInterest",
        "Command",
        "CommandOfInterest",
        "hasFunction",
        "hasFunctionKind",
        "hasFunctionOfInterest",
        "isFunctionOf",
        "isFunctionOfInterestOf",
        "hasCommand",
        "hasCommandKind",
        "hasCommandOfInterest",
        "isCommandOf",
        "isCommandOfInterestOf",
        "hasMandatoryCommand",
        "hasOptionalCommand"
      ],
      "finding": "A function groups commands. Required and optional membership conveys a support obligation at the function level. An individual device can have its own identifiable function and command."
    },
    {
      "id": "SRF-07",
      "subject": "Digital exposure",
      "terms": [
        "Service",
        "Operation",
        "offers",
        "isOfferedBy",
        "hasOperation",
        "isOperationOf",
        "represents"
      ],
      "finding": "A service exposes a function on a network. Its operation exposes a command. This permits tracing a digital interface back to the particular capability it represents."
    },
    {
      "id": "SRF-08",
      "subject": "Execution and time",
      "terms": [
        "ProcedureExecution",
        "CommandExecution",
        "OperationExecution",
        "Observation",
        "Actuation",
        "isExecutionOf",
        "madeBy",
        "madeExecution",
        "hasInput",
        "hasOutput",
        "hasResult",
        "hasPhenomenonTime",
        "hasResultTime",
        "hasTimestamp"
      ],
      "finding": "Differentiate command-level execution from the network operation, and the performer from the feature targeted. Result time concerns completion. Phenomenon time concerns the phenomenon. Inputs and outputs alone do not establish an effect."
    },
    {
      "id": "SRF-09",
      "subject": "Conditional commodity price",
      "terms": [
        "Profile",
        "hasProfile",
        "isProfileOf",
        "profileHasPrice",
        "hasApplicableTime",
        "whenPropertyValue",
        "whenState"
      ],
      "finding": "A device commodity-price profile describes payment or earnings under a time, state or property-value condition. This is a specialized economic meaning distinct from an interoperability profile."
    }
  ],
